{
  "$schema": "https://raw.githubusercontent.com/scanoss/schema/main/scanoss-settings-schema.json",
  "settings": {
    "skip": {
      "patterns": {
        "scanning": [
          ".git/",
          ".deputy/",
          ".venv/",
          "venv/",
          ".tox/",
          ".nox/",
          "__pycache__/",
          "**/__pycache__/",
          ".pytest_cache/",
          ".mypy_cache/",
          ".ruff_cache/",
          ".coverage",
          "coverage.xml",
          "htmlcov/",
          "build/",
          "dist/",
          "site/",
          "*.egg-info/",
          "**/*.egg-info/",
          "node_modules/",
          "target/",
          "scanoss.json",
          "LICENSE",
          ".github/swh-provenance-allowlist.json",
          "uv.lock",
          "**/*.pyc",
          "**/*.pyo",
          "**/*.so",
          "**/*.dylib",
          "**/*.class"
        ],
        "fingerprinting": [
          ".git/",
          ".deputy/",
          ".venv/",
          "venv/",
          ".tox/",
          ".nox/",
          "__pycache__/",
          "**/__pycache__/",
          ".pytest_cache/",
          ".mypy_cache/",
          ".ruff_cache/",
          ".coverage",
          "coverage.xml",
          "htmlcov/",
          "build/",
          "dist/",
          "site/",
          "*.egg-info/",
          "**/*.egg-info/",
          "node_modules/",
          "target/",
          "scanoss.json",
          "LICENSE",
          ".github/swh-provenance-allowlist.json",
          "uv.lock",
          "**/*.pyc",
          "**/*.pyo",
          "**/*.so",
          "**/*.dylib",
          "**/*.class"
        ]
      }
    },
    "file_snippet": {
      "dependency_analysis": false
    }
  },
  "bom": {
    "include": [],
    "remove": [
      {
        "purl": "pkg:pypi/deproc-core",
        "comment": "Ignore self-matches against prior deproc releases"
      },
      {
        "purl": "pkg:pypi/deproc-java",
        "comment": "Ignore self-matches against prior deproc releases"
      },
      {
        "purl": "pkg:pypi/deproc-python",
        "comment": "Ignore self-matches against prior deproc releases"
      },
      {
        "purl": "pkg:pypi/deproc-utils-tree-sitter",
        "comment": "Ignore self-matches against prior deproc releases"
      }
    ]
  }
}
